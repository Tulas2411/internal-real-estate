# LOCAL ONLY. Replace every secret before deploying.
DATABASE_URL=postgresql://estate:local_estate_only@localhost:5432/estate?schema=public
BETTER_AUTH_SECRET=local-only-replace-with-random-32-character-secret
APP_URL=http://localhost:3000
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=estate-private
S3_ACCESS_KEY_ID=local_estate
S3_SECRET_ACCESS_KEY=local_storage_only
S3_FORCE_PATH_STYLE=true
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
# Required explicitly for seed (at least 12 characters), never used in production.
DEMO_PASSWORD=
# Separate disposable database; name must end in _test.
TEST_DATABASE_URL=postgresql://estate:local_estate_only@localhost:5432/estate_test?schema=public
